            "--- /dev/null",
            "+++ b/chronicle/i18n.py",
            "@@ -0,0 +1,171 @@",
            "+\"\"\"English and Japanese strings used by the narrator and the HTML player.\"\"\"",
            "+",
            "+from __future__ import annotations",
            "+",
            "+LANGS = (\"ja\", \"en\")",
            "+",
            "+KIND_LABEL = {",
            "+    \"en\": {",
            "+        \"feat\": \"feature\",",
            "+        \"fix\": \"bug fix\",",
            "+        \"docs\": \"documentation\",",
            "+        \"test\": \"tests\",",
            "+        \"refactor\": \"refactor\",",
