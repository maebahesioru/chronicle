          "truncated": true,
          "lines": [
            "diff --git a/chronicle/core/cite.py b/chronicle/core/cite.py",
            "new file mode 100644",
            "index 0000000..d5b203c",
            "--- /dev/null",
            "+++ b/chronicle/core/cite.py",
            "@@ -0,0 +1,298 @@",
            "+\"\"\"The citation contract.",
            "+",
            "+Chronicle refuses to publish a sentence that cannot be traced back to the",
            "+repository. A sentence is valid when it contains at least one citation that",
            "+points at real evidence from its chapter:",
            "+",
            "+  * a commit SHA (7 to 40 hex characters, at least one letter and one digit),",
            "+  * a file path that the chapter actually touched,",
            "+  * an issue number (#123) that appears in the chapter's commit messages.",
            "+",
            "+Citations that merely look valid but are absent from the evidence are",
            "+treated as errors, not as decoration. That is what keeps the narrated",
            "+summary honest: a hallucinated SHA loses the whole sentence.",
            "+\"\"\"",
            "+",
            "+from __future__ import annotations",
            "+",
            "+import re",
            "+from dataclasses import dataclass, field",
            "+",
            "+SHA_RE = re.compile(r\"(?<![0-9a-zA-Z])[0-9a-fA-F]{7,40}(?![0-9a-zA-Z])\")",
            "+PATH_RE = re.compile(",
            "+    r\"(?<![\\w/.\\-])((?:[\\w.\\-]+/)*[\\w.\\-]+\\.[A-Za-z][A-Za-z0-9]{0,7})(?![\\w/\\-])\"",
            "+)"
          ]
        },
        {
          "path": "tests/test_cite.py",
          "sha": "629c8fb",
          "truncated": true,
          "lines": [
            "diff --git a/tests/test_cite.py b/tests/test_cite.py",
            "new file mode 100644",
            "index 0000000..d13cb2e",
            "--- /dev/null",
            "+++ b/tests/test_cite.py",
            "@@ -0,0 +1,132 @@",
            "+\"\"\"The citation contract: no citation, no sentence.\"\"\"",
            "+",
            "+from __future__ import annotations",
            "+",
            "+import pytest",
            "+",
            "+from chronicle.core.cite import (",
            "+    Enforcement,",
            "+    Evidence,",
            "+    enforce,",
            "+    find_citations,",
            "+    inspect_sentence,",
            "+    split_sentences,",
            "+    validate_sentence,",
            "+)",
            "+from chronicle.core.model import Chapter, Commit",
            "+",
            "+",
            "+EVIDENCE = Evidence(",
            "+    shas=[\"a1b2c3d4e5f60718293a4b5c6d7e8f9012345678\"],",
            "+    paths=[\"src/core/parser.py\", \"docs/guide.md\"],",
            "+    issues=[\"42\"],",
            "+)",
            "+"
          ]
        },
        {
          "path": "chronicle/core/cluster.py",
          "sha": "629c8fb",
          "truncated": true,
          "lines": [
            "diff --git a/chronicle/core/cluster.py b/chronicle/core/cluster.py",
            "new file mode 100644",
            "index 0000000..6e059ec",
            "--- /dev/null",
            "+++ b/chronicle/core/cluster.py",
            "@@ -0,0 +1,122 @@",
            "+\"\"\"Turn a flat commit list into chronological chapters.",
            "+",
            "+Two signals decide the grouping, in this order:",
            "+",
            "+1. Conventional commit type (and scope, when present). Every feat commit",
            "+   belongs to the feat chapter, every fix to the fix chapter, and so on.",
            "+2. File-set similarity for commits that do not follow the convention. A",
            "+   commit joins the earliest earlier cluster whose path set overlaps enough",
            "+   (Jaccard) and starts a new cluster otherwise.",
            "+",
            "+The pass is deterministic: input order is the git log order (oldest first)",
            "+and every tie is broken by first appearance, never by hashing.",
            "+\"\"\"",
            "+",
            "+from __future__ import annotations",
            "+",
            "+from dataclasses import dataclass, field",
            "+",
            "+from .model import Chapter, Commit",
            "+",
            "+DEFAULT_SIMILARITY = 0.34",
            "+DEFAULT_MAX_COMMITS = 8",
            "+",
            "+"
          ]
        }
